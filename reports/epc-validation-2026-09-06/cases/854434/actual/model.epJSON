    "site": {
      "latitude": 57.7089,
      "longitude": 11.9746,
      "time_zone": 1.0,
      "elevation": 3.0
    }
  },
  "RunPeriod": {
    "annual": {
      "begin_month": 1,
      "begin_day_of_month": 1,
      "end_month": 12,
      "end_day_of_month": 31,
      "begin_year": 2017,
      "end_year": 2017,
      "use_weather_file_daylight_saving_period": "No",
      "use_weather_file_holidays_and_special_days": "No"
    }
  },
