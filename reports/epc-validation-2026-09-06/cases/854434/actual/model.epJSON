    "timestep": {
      "number_of_timesteps_per_hour": 6
    }
  },
  "GlobalGeometryRules": {
    "geometry": {
      "starting_vertex_position": "UpperLeftCorner",
      "vertex_entry_direction": "Counterclockwise",
      "coordinate_system": "World"
    }
  },
  "HeatBalanceAlgorithm": {
    "heat_balance": {
      "algorithm": "ConductionTransferFunction"
    }
  },
